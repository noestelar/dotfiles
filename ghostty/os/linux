# Ghostty — Linux entrypoint (deploy to ~/.config/ghostty/config on Linux)
config-file = ?base

# Keep Linux splits/nav on ctrl-based chords (Cmd->Ctrl via keyd).
keybind = ctrl+d=new_split:right
keybind = ctrl+shift+d=new_split:down
keybind = ctrl+w=close_surface
keybind = ctrl+alt+left=goto_split:left
keybind = ctrl+alt+right=goto_split:right
keybind = ctrl+alt+up=goto_split:up
keybind = ctrl+alt+down=goto_split:down
keybind = ctrl+t=new_tab
keybind = ctrl+shift+left_bracket=previous_tab
keybind = ctrl+shift+right_bracket=next_tab
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+equal=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+0=reset_font_size
keybind = ctrl+shift+comma=reload_config

# Slightly crisper on most Linux displays.
font-thicken = false

config-file = ?local
